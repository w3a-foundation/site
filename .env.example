# W3A site — environment overrides. All optional. Defaults in src/lib/brand.ts.

# Brand surface
# W3A_BRAND_NAME=Web3 Alliance
# W3A_BRAND_SHORT=W3A
# W3A_BRAND_TAGLINE=Post-Quantum Financial Services Ecosystem & Global Federation
# W3A_BRAND_DOMAIN=w3a.foundation

# Contact
# W3A_CONTACT_EMAIL=hello@w3a.foundation
# W3A_MEMBERSHIP_EMAIL=membership@w3a.foundation
# W3A_PRESS_EMAIL=press@w3a.foundation

# API + docs
# NEXT_PUBLIC_W3A_API_BASE=https://api.w3a.foundation
# W3A_DOCS_HOST=docs.w3a.foundation

# Prebuild: absolute path to canonical PDF (defaults walk sibling repos).
# W3A_PAPER_SOURCE=/Users/z/work/lux/legal/alliance/Web3_Alliance.pdf
